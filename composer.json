{
    "require": {
        "robertdevore/wpcom-check": "^1.0"
    },
    "require-dev": {
        "yoast/phpunit-polyfills": "^2",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "agent-docs:discover": "php scripts/agent-docs.php discover",
        "agent-docs:build": "php scripts/agent-docs.php build",
        "agent-docs:refresh": [
            "@agent-docs:discover",
            "@agent-docs:build"
        ],
        "agent-docs:check": "php scripts/agent-docs.php check",
        "agent-docs:query": "php scripts/agent-docs.php query",
        "test": "phpunit --testsuite \"DBVC Plugin\"",
        "test:smoke": "phpunit --filter PluginBootstrapSmokeTest",
        "test:proposal-diff": "phpunit --group proposal-diff",
        "test:proposal-diff-resolved": "phpunit --group proposal-diff --exclude-group proposal-diff-pending --do-not-cache-result",
        "test:proposal-diff-pending": "phpunit --group proposal-diff-pending --do-not-cache-result"
    }
}
